{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LlmMock": {
    // Used for any model/deployment name not listed under Deployments.
    "DefaultProfile": "gpt-4o",
    // Minimum gap between stream writes after the first token. Lower = finer token timing, higher = more streams.
    "StreamTickMilliseconds": 25,
    "AdminApiEnabled": true,

    // ILLUSTRATIVE numbers only. Calibrate from your own production telemetry
    // (p50 and p99 of TTFT, mean inter-token latency per response, and output tokens).
    "Profiles": {
      "gpt-4o": {
        "Encoding": "o200k_base",
        "TimeToFirstTokenMs": { "Median": 450, "P99": 1800 },
        "PrefillMsPer1kInputTokens": 25,
        "InterTokenLatencyMs": { "Median": 18, "P99": 45 },
        "InterTokenJitter": 0.2,
        "OutputTokens": { "Median": 280, "P99": 1100 },
        "MaxOutputTokens": 4096
      },
      "gpt-4o-mini": {
        "Encoding": "o200k_base",
        "TimeToFirstTokenMs": { "Median": 300, "P99": 1200 },
        "PrefillMsPer1kInputTokens": 12,
        "InterTokenLatencyMs": { "Median": 9, "P99": 25 },
        "InterTokenJitter": 0.2,
        "OutputTokens": { "Median": 250, "P99": 1000 },
        "MaxOutputTokens": 4096
      }
    },

    // Keys match the Azure deployment name in the URL, or the OpenAI "model" field.
    "Deployments": {
      "gpt-4o-eastus": {
        "Profile": "gpt-4o",
        "RequestsPerMinute": 300,
        "TokensPerMinute": 50000
      },
      "gpt-4o-westeurope": {
        "Profile": "gpt-4o",
        "RequestsPerMinute": 300,
        "TokensPerMinute": 50000
      },
      "gpt-4o-mini": {
        "Profile": "gpt-4o-mini",
        "RequestsPerMinute": 1000,
        "TokensPerMinute": 200000,
        "Faults": {
          "ServerErrorRate": 0.001,
          "MidStreamDisconnectRate": 0.001
        }
      }
    }
  }
}
